{
    "mcpServers": {
        "repository-manager": {
            "command": "node",
            "args": ["mcp-server/index.js"],
            "env": {
                "REPO_MANAGER_ALLOWED_ROOTS": "${workspaceFolder}",
                "REPO_MANAGER_ENABLE_APPLY": "false"
            }
        }
    }
}
